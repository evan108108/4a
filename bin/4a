#!/usr/bin/env node
// 4A CLI — subcommand dispatcher for the hosted gateway.
//
// Phase 3 v0 subcommands:
//   4a score <event_id> --value <0..1> --rationale "<text>" [--tier <str>] [--intent <str>] [--a-tag <kind:pubkey:d>]
//   4a comment <event_id> --body "<text>" [--intent <str>] [--reply-to <event_id>] [--a-tag <kind:pubkey:d>]
//
// Auth: reads a 4A bearer JWT from $FOUR_A_JWT (or $FOA_JWT, alias). Obtain
// one via the OAuth flow at https://api.4a4.ai/auth/github/start (or the
// equivalent google flow). The CLI passes it as `Authorization: Bearer <jwt>`
// on every request — same gating as the hosted /v0/score and /v0/comment
// endpoints used by the MCP `score` / `comment` tools.
//
// Gateway override: $FOUR_A_GATEWAY (defaults to https://api.4a4.ai).
//
// Exit codes: 0 on success, 1 on gateway/network error, 2 on bad usage.

import { parseArgs } from "node:util";

const DEFAULT_GATEWAY = "https://api.4a4.ai";

function getJwt() {
  return process.env.FOUR_A_JWT ?? process.env.FOA_JWT ?? "";
}
function getGateway() {
  return (process.env.FOUR_A_GATEWAY ?? DEFAULT_GATEWAY).replace(/\/$/, "");
}

function die(code, message) {
  process.stderr.write(message.endsWith("\n") ? message : `${message}\n`);
  process.exit(code);
}

const HELP_ROOT = `4a — Agent-Agnostic Accessible Archive CLI

Usage: 4a <subcommand> [options]

Subcommands:
  score      Publish a kind:30506 score and its paired kind:30507 rationale
  comment    Publish a standalone kind:30507 comment
  audience   v0.5 — manage private audiences (create / invite / grant / claim / rotate / publish / inbox)

Auth:
  Set FOUR_A_JWT to a 4A bearer JWT before running. Obtain one via
  https://api.4a4.ai/auth/github/start (or /auth/google/start).

Environment:
  FOUR_A_JWT       Bearer JWT for the hosted gateway (required).
  FOUR_A_GATEWAY   Gateway base URL (default: ${DEFAULT_GATEWAY}).

Run "4a <subcommand> --help" for subcommand-specific options.
`;

const HELP_SCORE = `4a score — publish a paired score + rationale

Usage:
  4a score <event_id> --value <0..1> --rationale "<text>" [options]

Arguments:
  <event_id>           64-char hex id of the target event being scored

Required options:
  --value <number>     Score in [0, 1]
  --rationale <text>   Justifying text (published as a paired kind:30507)

Optional options:
  --tier <string>      Tier label (per-aggregator vocabulary)
  --intent <string>    Intent label for the rationale comment (default: justify)
  --a-tag <addr>       Addressable a-tag of the target (kind:pubkey:d)

Prints both event ids and nostr: URIs on success.
`;

const HELP_COMMENT = `4a comment — publish a standalone comment

Usage:
  4a comment <event_id> --body "<text>" [options]

Arguments:
  <event_id>           64-char hex id of the target event being commented on

Required options:
  --body <text>        Comment body (non-empty)

Optional options:
  --intent <string>    Intent label (e.g. justify, challenge, context)
  --reply-to <id>      64-char hex parent comment id (threaded reply)
  --a-tag <addr>       Addressable a-tag of the target (kind:pubkey:d)

Prints the event id and nostr: URI on success.
`;

const HEX64 = /^[0-9a-f]{64}$/i;

async function postJson(path, body) {
  const jwt = getJwt();
  if (!jwt) {
    die(
      2,
      "missing FOUR_A_JWT — obtain a JWT via https://api.4a4.ai/auth/github/start and export it",
    );
  }
  const url = `${getGateway()}${path}`;
  let res;
  try {
    res = await fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${jwt}`,
      },
      body: JSON.stringify(body),
    });
  } catch (err) {
    die(1, `network error contacting ${url}: ${err.message}`);
  }
  let data = null;
  try {
    data = await res.json();
  } catch {
    /* fall through with null */
  }
  if (!res.ok) {
    const msg = data?.message || data?.error || `HTTP ${res.status}`;
    die(1, `gateway error (${res.status}): ${msg}`);
  }
  return data;
}

function nostrUri(eventId) {
  return `nostr:${eventId}`;
}

function requireEventIdArg(positionals, subcommand) {
  if (positionals.length === 0) {
    die(2, `4a ${subcommand}: missing <event_id> argument (run "4a ${subcommand} --help")`);
  }
  if (positionals.length > 1) {
    die(2, `4a ${subcommand}: unexpected extra arguments: ${positionals.slice(1).join(" ")}`);
  }
  const id = positionals[0];
  if (!HEX64.test(id)) {
    die(2, `4a ${subcommand}: <event_id> must be a 64-char hex string`);
  }
  return id.toLowerCase();
}

async function cmdScore(argv) {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      help: { type: "boolean", short: "h" },
      value: { type: "string" },
      rationale: { type: "string" },
      tier: { type: "string" },
      intent: { type: "string" },
      "a-tag": { type: "string" },
    },
  });
  if (values.help) {
    process.stdout.write(HELP_SCORE);
    return;
  }
  const eventId = requireEventIdArg(positionals, "score");
  if (values.value === undefined) die(2, "4a score: --value is required");
  const value = Number(values.value);
  if (!Number.isFinite(value) || value < 0 || value > 1) {
    die(2, "4a score: --value must be a finite number in [0, 1]");
  }
  if (!values.rationale || values.rationale.trim().length === 0) {
    die(2, "4a score: --rationale is required and must be non-empty");
  }

  const body = {
    target_event_id: eventId,
    value,
    rationale: values.rationale,
  };
  if (values.tier !== undefined) body.tier = values.tier;
  if (values.intent !== undefined) body.intent = values.intent;
  if (values["a-tag"] !== undefined) body.target_a_tag = values["a-tag"];

  const data = await postJson("/v0/score", body);
  process.stdout.write(
    [
      `score_event_id   ${data.score_event_id}`,
      `score_uri        ${nostrUri(data.score_event_id)}`,
      `comment_event_id ${data.comment_event_id}`,
      `comment_uri      ${nostrUri(data.comment_event_id)}`,
      `score_address    ${data.score_address}`,
      `comment_address  ${data.comment_address}`,
      `pubkey           ${data.pubkey}`,
      `npub             ${data.npub}`,
      "",
    ].join("\n"),
  );
}

async function cmdComment(argv) {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      help: { type: "boolean", short: "h" },
      body: { type: "string" },
      intent: { type: "string" },
      "reply-to": { type: "string" },
      "a-tag": { type: "string" },
    },
  });
  if (values.help) {
    process.stdout.write(HELP_COMMENT);
    return;
  }
  const eventId = requireEventIdArg(positionals, "comment");
  if (!values.body || values.body.trim().length === 0) {
    die(2, "4a comment: --body is required and must be non-empty");
  }
  const replyTo = values["reply-to"];
  if (replyTo !== undefined && !HEX64.test(replyTo)) {
    die(2, "4a comment: --reply-to must be a 64-char hex event id");
  }

  const requestBody = {
    target_event_id: eventId,
    body: values.body,
  };
  if (values.intent !== undefined) requestBody.intent = values.intent;
  if (replyTo !== undefined) requestBody.reply_to_event_id = replyTo.toLowerCase();
  if (values["a-tag"] !== undefined) requestBody.target_a_tag = values["a-tag"];

  const data = await postJson("/v0/comment", requestBody);
  process.stdout.write(
    [
      `comment_event_id ${data.comment_event_id}`,
      `comment_uri      ${nostrUri(data.comment_event_id)}`,
      `address          ${data.address}`,
      `pubkey           ${data.pubkey}`,
      `npub             ${data.npub}`,
      "",
    ].join("\n"),
  );
}

// ─── 4a audience subcommands ─────────────────────────────────────────────────

const HELP_AUDIENCE = `4a audience — manage 4A v0.5 private audiences

Usage:
  4a audience create   --slug <slug> --name <name> [--description <text>]
  4a audience invite   --address <30520:pub:slug> --aud-id-priv <hex> [--ttl <seconds>]
  4a audience grant    --address <30520:pub:slug> --aud-id-priv <hex> --aud-epoch-priv <hex> --recipient <pubhex>
  4a audience claim    --address <30520:pub:slug> --epoch <n> --k <4ainv1...> --claim <pubhex> --inviter <pubhex> [--note <text>]
  4a audience rotate   --address <30520:pub:slug> --aud-id-priv <hex> [--add <pubhex>]* [--remove <pubhex>]* [--remove-pending <pubhex>]*
  4a audience publish  --address <30520:pub:slug> --aud-epoch-pub <hex> --kind <30510..30514> --d <slug> --alt <text> --payload <json>
  4a audience inbox    --slug <slug> [--since <unix>] [--limit <n>]
  4a audience process-claims --address <30520:pub:slug> --aud-id-priv <hex>

All subcommands require an auth bearer ($FOUR_A_JWT or $FOA_JWT) and use
the gateway at $FOUR_A_GATEWAY (default https://api.4a4.ai). Each prints
the gateway response as JSON on stdout.
`;

async function audiencePost(path, body) {
  const jwt = getJwt();
  if (!jwt) die(2, '4a audience: $FOUR_A_JWT not set (auth required)');
  const r = await fetch(`${getGateway()}${path}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${jwt}` },
    body: JSON.stringify(body),
  });
  const text = await r.text();
  let parsed = text;
  try { parsed = JSON.parse(text); } catch {}
  process.stdout.write(JSON.stringify(parsed, null, 2) + "\n");
  if (!r.ok) process.exit(1);
}

async function audienceGet(path) {
  const jwt = getJwt();
  if (!jwt) die(2, '4a audience: $FOUR_A_JWT not set (auth required)');
  const r = await fetch(`${getGateway()}${path}`, {
    headers: { Authorization: `Bearer ${jwt}` },
  });
  const text = await r.text();
  let parsed = text;
  try { parsed = JSON.parse(text); } catch {}
  process.stdout.write(JSON.stringify(parsed, null, 2) + "\n");
  if (!r.ok) process.exit(1);
}

function parseAudienceArgs(argv, options) {
  const { values, positionals } = parseArgs({ args: argv, options, allowPositionals: true, strict: false });
  return { values, positionals };
}

async function cmdAudience(argv) {
  if (argv.length === 0 || argv[0] === '-h' || argv[0] === '--help' || argv[0] === 'help') {
    process.stdout.write(HELP_AUDIENCE);
    return;
  }
  const sub = argv[0];
  const rest = argv.slice(1);
  switch (sub) {
    case 'create': {
      const { values } = parseAudienceArgs(rest, {
        slug: { type: 'string' }, name: { type: 'string' }, description: { type: 'string' },
      });
      if (!values.slug || !values.name) die(2, '4a audience create: --slug and --name required');
      return audiencePost('/v0/audience/create', { slug: values.slug, name: values.name, description: values.description });
    }
    case 'invite': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, 'aud-id-priv': { type: 'string' }, ttl: { type: 'string' },
      });
      if (!values.address || !values['aud-id-priv']) die(2, '4a audience invite: --address and --aud-id-priv required');
      const body = { audience_address: values.address, aud_id_priv: values['aud-id-priv'] };
      if (values.ttl) body.ttl_seconds = Number(values.ttl);
      return audiencePost('/v0/audience/invite', body);
    }
    case 'grant': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, 'aud-id-priv': { type: 'string' },
        'aud-epoch-priv': { type: 'string' }, recipient: { type: 'string' },
      });
      if (!values.address || !values['aud-id-priv'] || !values['aud-epoch-priv'] || !values.recipient) {
        die(2, '4a audience grant: --address, --aud-id-priv, --aud-epoch-priv, --recipient required');
      }
      return audiencePost('/v0/audience/grant', {
        audience_address: values.address,
        aud_id_priv: values['aud-id-priv'],
        aud_epoch_priv: values['aud-epoch-priv'],
        recipient_pubkey: values.recipient,
      });
    }
    case 'claim': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, epoch: { type: 'string' }, k: { type: 'string' },
        claim: { type: 'string' }, inviter: { type: 'string' }, note: { type: 'string' },
      });
      if (!values.address || !values.epoch || !values.k || !values.claim || !values.inviter) {
        die(2, '4a audience claim: --address, --epoch, --k, --claim, --inviter required');
      }
      return audiencePost('/v0/audience/claim', {
        audience_address: values.address,
        epoch: Number(values.epoch),
        invite_priv_4ainv: values.k,
        claim_pubkey: values.claim,
        inviter_pubkey: values.inviter,
        note: values.note,
      });
    }
    case 'rotate': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, 'aud-id-priv': { type: 'string' },
        add: { type: 'string', multiple: true }, remove: { type: 'string', multiple: true },
        'remove-pending': { type: 'string', multiple: true },
      });
      if (!values.address || !values['aud-id-priv']) {
        die(2, '4a audience rotate: --address and --aud-id-priv required');
      }
      return audiencePost('/v0/audience/rotate', {
        audience_address: values.address,
        aud_id_priv: values['aud-id-priv'],
        add_members: values.add ?? [],
        remove_members: values.remove ?? [],
        remove_pending: values['remove-pending'] ?? [],
      });
    }
    case 'publish': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, 'aud-epoch-pub': { type: 'string' },
        kind: { type: 'string' }, d: { type: 'string' }, alt: { type: 'string' },
        payload: { type: 'string' },
      });
      if (!values.address || !values['aud-epoch-pub'] || !values.kind || !values.d || !values.alt || !values.payload) {
        die(2, '4a audience publish: --address, --aud-epoch-pub, --kind, --d, --alt, --payload required');
      }
      let payload;
      try { payload = JSON.parse(values.payload); } catch (err) { die(2, `4a audience publish: --payload must be JSON: ${err.message}`); }
      return audiencePost('/v0/audience/publish', {
        audience_address: values.address,
        aud_epoch_pub: values['aud-epoch-pub'],
        kind: Number(values.kind),
        d_tag: values.d,
        alt: values.alt,
        payload,
      });
    }
    case 'inbox': {
      const { values } = parseAudienceArgs(rest, {
        slug: { type: 'string' }, since: { type: 'string' }, limit: { type: 'string' },
      });
      if (!values.slug) die(2, '4a audience inbox: --slug required');
      const params = new URLSearchParams();
      if (values.since) params.set('since', values.since);
      if (values.limit) params.set('limit', values.limit);
      const qs = params.toString();
      return audienceGet(`/v0/audience/${encodeURIComponent(values.slug)}/inbox${qs ? '?' + qs : ''}`);
    }
    case 'process-claims': {
      const { values } = parseAudienceArgs(rest, {
        address: { type: 'string' }, 'aud-id-priv': { type: 'string' },
      });
      if (!values.address || !values['aud-id-priv']) {
        die(2, '4a audience process-claims: --address and --aud-id-priv required');
      }
      return audiencePost('/v0/audience/process-claims', {
        audience_address: values.address,
        aud_id_priv: values['aud-id-priv'],
      });
    }
    default:
      die(2, `4a audience: unknown subcommand "${sub}" (run "4a audience --help")`);
  }
}

async function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "-h" || argv[0] === "--help" || argv[0] === "help") {
    process.stdout.write(HELP_ROOT);
    return;
  }
  const subcommand = argv[0];
  const rest = argv.slice(1);
  switch (subcommand) {
    case "score":
      await cmdScore(rest);
      return;
    case "comment":
      await cmdComment(rest);
      return;
    case "audience":
      await cmdAudience(rest);
      return;
    default:
      die(2, `4a: unknown subcommand "${subcommand}" (run "4a --help")`);
  }
}

main().catch((err) => {
  die(1, `4a: ${err?.stack ?? err?.message ?? String(err)}`);
});
